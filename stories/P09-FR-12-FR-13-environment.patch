diff -ruN a/src/parser.c b/src/parser.c
--- a/src/parser.c	2026-10-22 08:41:59.523707569 +0000
+++ b/src/parser.c	2026-10-22 08:43:26.455066205 +0000
@@ -88,6 +88,55 @@
 
 /* ---------- Expansion -------------------------------------------------- */
 
+/* *pp points at '$'. Appends the expansion to sb and advances *pp.
+ * Returns 0 on success, -1 on a malformed ${...}. */
+static int expand_dollar(const char **pp, int last_status, StrBuf *sb)
+{
+    const char *p = *pp;
+    char tmp[32];
+
+    if (p[1] == '?') {
+        snprintf(tmp, sizeof tmp, "%d", last_status);
+        sb_puts(sb, tmp);
+        *pp = p + 2;
+    } else if (p[1] == '$') {
+        snprintf(tmp, sizeof tmp, "%ld", (long)getpid());
+        sb_puts(sb, tmp);
+        *pp = p + 2;
+    } else if (p[1] == '{') {
+        const char *close = strchr(p + 2, '}');
+        char *name;
+        const char *val;
+        if (!close || !is_valid_name(p + 2, (size_t)(close - (p + 2))))
+            return -1;
+        name = xmalloc((size_t)(close - (p + 2)) + 1);
+        memcpy(name, p + 2, (size_t)(close - (p + 2)));
+        name[close - (p + 2)] = '\0';
+        val = getenv(name);
+        if (val)
+            sb_puts(sb, val);
+        free(name);
+        *pp = close + 1;
+    } else if (isalpha((unsigned char)p[1]) || p[1] == '_') {
+        const char *e = p + 1;
+        char *name;
+        const char *val;
+        while (isalnum((unsigned char)*e) || *e == '_')
+            e++;
+        name = xmalloc((size_t)(e - (p + 1)) + 1);
+        memcpy(name, p + 1, (size_t)(e - (p + 1)));
+        name[e - (p + 1)] = '\0';
+        val = getenv(name);
+        if (val)
+            sb_puts(sb, val);
+        free(name);
+        *pp = e;
+    } else {
+        sb_putc(sb, '$');          /* lone '$' is literal */
+        *pp = p + 1;
+    }
+    return 0;
+}
 
