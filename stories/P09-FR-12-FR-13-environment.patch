+/* ---- export / unset / env ---------------------------------------------- */
+static int bi_export(Shell *sh, int argc, char **argv)
+{
+    int i, status = 0;
+    (void)sh;
+
+    if (argc == 1)
+        return bi_env(sh, argc, argv);
+
+    for (i = 1; i < argc; i++) {
+        char *eq = strchr(argv[i], '=');
+        if (eq) {
+            if (!is_valid_name(argv[i], (size_t)(eq - argv[i]))) {
+                shell_error("export: '%s': not a valid identifier", argv[i]);
+                status = 1;
+                continue;
+            }
+            *eq = '\0';
+            if (setenv(argv[i], eq + 1, 1) != 0) {
+                shell_error("export: %s", strerror(errno));
+                status = 1;
+            }
+            *eq = '=';
+        } else if (!is_valid_name(argv[i], strlen(argv[i]))) {
+            shell_error("export: '%s': not a valid identifier", argv[i]);
+            status = 1;
+        } else if (!getenv(argv[i])) {
+            setenv(argv[i], "", 1);
+        }
+    }
+    return status;
+}
+
+static int bi_unset(Shell *sh, int argc, char **argv)
+{
+    int i, status = 0;
+    (void)sh;
+    for (i = 1; i < argc; i++) {
+        if (!is_valid_name(argv[i], strlen(argv[i]))) {
+            shell_error("unset: '%s': not a valid identifier", argv[i]);
+            status = 1;
+        } else {
+            unsetenv(argv[i]);
+        }
+    }
+    return status;
+}
+
+static int bi_env(Shell *sh, int argc, char **argv)
+{
+    char **e;
+    (void)sh; (void)argc; (void)argv;
+    for (e = environ; e && *e; e++)
+        printf("%s\n", *e);
+    return 0;
+}
