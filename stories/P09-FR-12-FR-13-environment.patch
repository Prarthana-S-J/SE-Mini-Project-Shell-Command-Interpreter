+static int all_assignments(const Command *c)
+{
+    int i;
+    if (c->argc == 0)
+        return 0;
+    for (i = 0; i < c->argc; i++)
+        if (!is_assignment(c->argv[i]))
+            return 0;
+    return 1;
+}
+
+static int run_assignments(const Command *c)
+{
+    int i;
+    for (i = 0; i < c->argc; i++) {
+        char *eq = strchr(c->argv[i], '=');
+        *eq = '\0';
+        setenv(c->argv[i], eq + 1, 1);
+        *eq = '=';
+    }
+    return 0;
+}
 
 /* Run a built-in in the shell process so cd/exit/export affect the shell. */
 static int run_builtin_in_parent(Shell *sh, const Command *c)
