diff -ruN a/.github/workflows/ci.yml b/.github/workflows/ci.yml
--- a/.github/workflows/ci.yml	1970-01-01 00:00:00.000000000 +0000
+++ b/.github/workflows/ci.yml	2026-10-12 08:56:56.663835000 +0000
@@ -0,0 +1,55 @@
+name: CI
+
+on:
+  push:
+    branches: [main]
+  pull_request:
+
+permissions:
+  contents: read
+
+jobs:
+  build-and-test:
+    name: build-and-test
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - name: Install tools
+        run: sudo apt-get update && sudo apt-get install -y build-essential python3
+      - name: Build (warnings are errors)
+        run: |
+          make clean
+          make CFLAGS="-std=c11 -Wall -Wextra -Wpedantic -Werror -O2 -g"
+      - name: Unit tests (parser and utilities)
+        run: make unit-test
+      - name: Functional, integration, security and non-functional tests
+        run: bash tests/run_tests.sh
+      - name: Pseudo-terminal system tests (prompt, Ctrl+C, Ctrl+D, background jobs)
+        run: python3 tests/interactive_test.py
+      - name: Fuzzing under AddressSanitizer + UBSan
+        run: make fuzz
+      - name: Job summary
+        if: always()
+        run: |
+          {
+            echo "## Test results"
+            for f in tests/results_unit.txt tests/results_functional.txt tests/results_interactive.txt tests/results_fuzz.txt; do
+              [ -f "$f" ] && { echo "### $f"; echo '```'; grep -E "FAIL|SUMMARY|SC-12|SC-13" "$f" || true; echo '```'; }
+            done
+          } >> "$GITHUB_STEP_SUMMARY"
+      - name: Upload result files
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: test-results
+          path: tests/results_*
+
+  sanitizer:
+    name: sanitizer-build
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - name: Install tools
+        run: sudo apt-get update && sudo apt-get install -y build-essential python3
+      - name: Unit and functional suites with ASan/UBSan/LSan
+        run: make sanitize
diff -ruN a/.github/workflows/labeler.yml b/.github/workflows/labeler.yml
--- a/.github/workflows/labeler.yml	1970-01-01 00:00:00.000000000 +0000
+++ b/.github/workflows/labeler.yml	2026-10-12 08:56:56.739776000 +0000
@@ -0,0 +1,17 @@
+name: Label PRs by component
+
+on:
+  pull_request_target:
+
+permissions:
+  contents: read
+  pull-requests: write
+
+jobs:
+  label:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/labeler@v5
+        with:
+          repo-token: ${{ secrets.GITHUB_TOKEN }}
+          configuration-path: .github/labeler.yml
diff -ruN a/.github/workflows/pr-hygiene.yml b/.github/workflows/pr-hygiene.yml
--- a/.github/workflows/pr-hygiene.yml	1970-01-01 00:00:00.000000000 +0000
+++ b/.github/workflows/pr-hygiene.yml	2026-10-12 08:56:56.738956000 +0000
@@ -0,0 +1,33 @@
+name: PR hygiene
+
+on:
+  pull_request:
+    types: [opened, edited, synchronize, reopened]
+
+permissions:
+  pull-requests: write
+  issues: write
+
+jobs:
+  check:
+    runs-on: ubuntu-latest
+    steps:
+      - name: Check title and linked issue
+        uses: actions/github-script@v7
+        with:
+          script: |
+            const pr = context.payload.pull_request;
+            const problems = [];
+            if (!/^(FR|NFR|SR|CH)-\d+[: ]/.test(pr.title)) {
+              problems.push("The title should start with a backlog ID, e.g. `FR-09: add pwd built-in`.");
+            }
+            if (!/\b(close[sd]?|fix(e[sd])?|resolve[sd]?)\s+#\d+/i.test(pr.body || "")) {
+              problems.push("The description should link the issue with `Closes #<number>`.");
+            }
+            if (problems.length) {
+              await github.rest.issues.createComment({
+                owner: context.repo.owner, repo: context.repo.repo, issue_number: pr.number,
+                body: "PR checklist:\n\n- " + problems.join("\n- ")
+              });
+              core.setFailed(problems.join(" "));
+            }
diff -ruN a/.github/workflows/project-automation.yml b/.github/workflows/project-automation.yml
--- a/.github/workflows/project-automation.yml	1970-01-01 00:00:00.000000000 +0000
+++ b/.github/workflows/project-automation.yml	2026-10-12 08:56:56.812569000 +0000
@@ -0,0 +1,20 @@
+# Optional: adds every new issue and PR to the GitHub Project automatically.
+# Needs a repository variable PROJECT_URL (e.g. https://github.com/users/<owner>/projects/1)
+# and a secret PROJECT_TOKEN (a personal access token with the "project" scope).
+name: Add to project
+
+on:
+  issues:
+    types: [opened]
+  pull_request:
+    types: [opened]
+
+jobs:
+  add:
+    if: ${{ vars.PROJECT_URL != '' }}
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/add-to-project@v1.0.2
+        with:
+          project-url: ${{ vars.PROJECT_URL }}
+          github-token: ${{ secrets.PROJECT_TOKEN }}
