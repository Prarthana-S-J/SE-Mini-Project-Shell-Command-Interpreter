     return 0;
 }
 
+/* ---- Background job table (Member 3) ----------------------------------- */
+
+static void jobs_add(Shell *sh, pid_t pid, const char *text)
+{
+    int id = sh->next_job_id++;
+
+    if (sh->njobs < MAX_JOBS) {
+        Job *j = &sh->jobs[sh->njobs++];
+        j->id = id;
+        j->pid = pid;
+        j->text = xstrdup(text);
+    }
+    if (sh->interactive)
+        fprintf(stderr, "[%d] %ld\n", id, (long)pid);
+}
+
+void jobs_reap(Shell *sh)
+{
+    int status;
+    pid_t pid;
+
+    while ((pid = waitpid(-1, &status, WNOHANG)) > 0) {
+        int i;
+        for (i = 0; i < sh->njobs; i++) {
+            if (sh->jobs[i].pid != pid)
+                continue;
+            if (sh->interactive)
+                fprintf(stderr, "[%d]+  Done                    %s\n",
+                        sh->jobs[i].id, sh->jobs[i].text);
+            free(sh->jobs[i].text);
+            sh->jobs[i] = sh->jobs[sh->njobs - 1];
+            sh->njobs--;
+            break;
+        }
+    }
+    if (sh->njobs == 0)
+        sh->next_job_id = 1;
+}
 
 /* ---- Child side (Member 1 / Member 3) ---------------------------------- */
 
 static void exec_child(Shell *sh, const Command *c, int in_fd, int out_fd,
                        int background, int first)
 {
