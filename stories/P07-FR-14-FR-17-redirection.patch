diff -ruN a/src/executor.c b/src/executor.c
--- a/src/executor.c	2026-10-22 08:39:05.469007029 +0000
+++ b/src/executor.c	2026-10-22 08:40:32.370035696 +0000
@@ -24,6 +24,42 @@
 #include "builtins.h"
 #include "utils.h"
 
+/* ---- Redirection (Member 3) -------------------------------------------- */
+
+/* Apply < > >> of `c` to fds 0/1. Returns 0, or -1 after printing an error. */
+static int apply_redirections(const Command *c)
+{
+    int fd;
+
+    if (c->infile) {
+        fd = open(c->infile, O_RDONLY);
+        if (fd < 0) {
+            shell_error("%s: %s", c->infile, strerror(errno));
+            return -1;
+        }
+        if (dup2(fd, STDIN_FILENO) < 0) {
+            shell_error("dup2: %s", strerror(errno));
+            close(fd);
+            return -1;
+        }
+        close(fd);
+    }
+    if (c->outfile) {
+        int flags = O_WRONLY | O_CREAT | (c->append ? O_APPEND : O_TRUNC);
+        fd = open(c->outfile, flags, 0644);
+        if (fd < 0) {
+            shell_error("%s: %s", c->outfile, strerror(errno));
+            return -1;
+        }
+        if (dup2(fd, STDOUT_FILENO) < 0) {
+            shell_error("dup2: %s", strerror(errno));
+            close(fd);
+            return -1;
+        }
+        close(fd);
+    }
+    return 0;
+}
 
 
 /* ---- Child side (Member 1 / Member 3) ---------------------------------- */
@@ -42,6 +78,8 @@
         dup2(out_fd, STDOUT_FILENO);
         close(out_fd);
     }
+    if (apply_redirections(c) < 0)
+        _exit(1);
 
     if (is_builtin(c->argv[0])) {
         int st = run_builtin(sh, c->argc, c->argv);
@@ -91,7 +129,29 @@
 /* Run a built-in in the shell process so cd/exit/export affect the shell. */
 static int run_builtin_in_parent(Shell *sh, const Command *c)
 {
-    return run_builtin(sh, c->argc, c->argv);
+    int saved_in = -1, saved_out = -1, status;
+
+    if (c->infile)
+        saved_in = dup(STDIN_FILENO);
+    if (c->outfile)
+        saved_out = dup(STDOUT_FILENO);
+    fflush(stdout);
+
+    if (apply_redirections(c) < 0)
+        status = 1;
+    else
+        status = run_builtin(sh, c->argc, c->argv);
+
+    fflush(stdout);
+    if (saved_in >= 0) {
+        dup2(saved_in, STDIN_FILENO);
+        close(saved_in);
+    }
+    if (saved_out >= 0) {
+        dup2(saved_out, STDOUT_FILENO);
+        close(saved_out);
+    }
+    return status;
 }
 
 int execute_pipeline(Shell *sh, const Pipeline *pl)
