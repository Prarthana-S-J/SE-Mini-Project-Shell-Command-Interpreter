diff -ruN a/src/shell.c b/src/shell.c
--- a/src/shell.c	2026-10-22 18:43:39.089454188 +0000
+++ b/src/shell.c	2026-10-22 18:45:03.991647609 +0000
@@ -24,6 +24,11 @@
 
 volatile sig_atomic_t g_sigint_flag = 0;
 
+static void sigint_handler(int sig)
+{
+    (void)sig;
+    g_sigint_flag = 1;   /* only set a flag: async-signal-safe */
+}
 
 void shell_init(Shell *sh)
 {
@@ -43,7 +48,27 @@
 
 void shell_setup_signals(const Shell *sh)
 {
-    (void)sh;       /* Ctrl+C handling is added by story FR-21 */
+    struct sigaction sa;
+
+    if (!sh->interactive)
+        return;
+
+    /* Ctrl+C: interrupt the current input line / foreground job, but never
+     * terminate the shell. SA_RESTART is deliberately NOT set so that a
+     * blocked read() on the prompt returns EINTR and the prompt is redrawn. */
+    memset(&sa, 0, sizeof sa);
+    sa.sa_handler = sigint_handler;
+    sigemptyset(&sa.sa_mask);
+    sa.sa_flags = 0;
+    sigaction(SIGINT, &sa, NULL);
+
+    /* Ctrl+\ and Ctrl+Z are ignored: the shell has no job control, so a
+     * stopped child could never be resumed. Ignored signals are inherited
+     * across exec, which gives foreground children the same protection. */
+    signal(SIGQUIT, SIG_IGN);
+    signal(SIGTSTP, SIG_IGN);
+    signal(SIGTTOU, SIG_IGN);
+    signal(SIGTTIN, SIG_IGN);
 }
 
 int shell_execute_line(Shell *sh, const char *line)
@@ -93,6 +118,15 @@
         errno = 0;
         n = getline(&line, &cap, in);
         if (n < 0) {
+            if (errno == EINTR) {            /* Ctrl+C at the prompt */
+                clearerr(in);
+                if (g_sigint_flag) {
+                    g_sigint_flag = 0;
+                    sh->last_status = 130;
+                }
+                fputc('\n', stderr);
+                continue;
+            }
             if (sh->interactive)
                 fputs("exit\n", stderr);     /* Ctrl+D */
             break;
